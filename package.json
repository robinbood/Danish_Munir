    "globals": "^17.12.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
